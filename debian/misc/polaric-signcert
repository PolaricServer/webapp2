#!/bin/bash
#
# signcert - Contact a polaric-certauth server to sign a certificate. Use the CSR generated by the newcert script. 
#
# Certificate files are written to:
#   /etc/polaric-webapp2/ssl/polaric.crt   (certificate)
#

CERTCLIENT="/usr/bin/certclient"
  CERT_DIR="/etc/polaric-webapp2/ssl"
 CERT_FILE="$CERT_DIR/polaric.crt"
  CSR_FILE="$CERT_DIR/polaric.csr"


if [[ ! -f "$CERTCLIENT" ]]; then
    echo "Error: certclient program not installed."
    exit 1
fi

if [[ ! -f "$CSR_FILE" ]]; then
    echo "Error: cannot find CSR file."
    exit 1
fi


$CERTCLIENT $CSR_FILE $CERT_FILE

